# ---------------------------------------------------------------------
# CampusLock environment
#
# The app runs fully WITHOUT any of these (local in-process engine).
# Add them to enable the durable, multi-instance Supabase backend.
# Never put the service-role key in a NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------

# Public URL of this deployment. Used to build the join QR code.
# Local: http://localhost:3000
# Vercel: set automatically via VERCEL_PROJECT_PRODUCTION_URL if omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project — Settings → API
# Create at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / "publishable" key — safe to expose to the browser, used for
# Realtime subscriptions only. RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — SERVER ONLY. Bypasses RLS, so every host action
# re-validates the host token inside application code.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key